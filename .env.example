# Resend (contact form + recommendation notifications)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# Upstash Redis (reviews + views counter)
# Create a free DB at https://console.upstash.com/redis and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin auth for /admin/reviews moderation dashboard.
# Generate a long random secret: `openssl rand -hex 32`
ADMIN_TOKEN=

# Google OAuth — for Verified badge on recommendations.
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: https://your-domain.com/api/auth/callback/google
#    (for local dev: http://localhost:3000/api/auth/callback/google)
AUTH_SECRET=                     # openssl rand -hex 32
AUTH_GOOGLE_ID=                  # OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=              # OAuth 2.0 Client Secret

# Public base URL — used in sitemap, robots.txt, OG metadata, and approval email links.
# Set to your Vercel deployment URL or custom domain.
NEXT_PUBLIC_BASE_URL=https://shubhkamalsharma.vercel.app
NEXT_PUBLIC_SITE_URL=https://shubhkamalsharma.vercel.app
